<label class="input {{#if error}}input_error{{/if}}">
  <span class="input__label">{{label}}</span>
  <input
    class="input__field"
    type="{{#if type}}{{type}}{{else}}text{{/if}}"
    name="{{name}}"
    value="{{value}}"
    {{#if placeholder}}placeholder="{{placeholder}}"{{/if}}
  >
  <span class="input__error">{{error}}</span>
</label>
