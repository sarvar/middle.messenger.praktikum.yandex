<li class="chat-item {{#if active}}chat-item_active{{/if}}">
  {{> avatar}}
  <div class="chat-item__body">
    <div class="chat-item__top">
      <span class="chat-item__name">{{name}}</span>
      <span class="chat-item__time">{{time}}</span>
    </div>
    <div class="chat-item__bottom">
      <p class="chat-item__text">
        {{#if own}}<span class="chat-item__own">Вы: </span>{{/if}}{{text}}
      </p>
      {{#if count}}<span class="chat-item__count">{{count}}</span>{{/if}}
    </div>
  </div>
</li>
