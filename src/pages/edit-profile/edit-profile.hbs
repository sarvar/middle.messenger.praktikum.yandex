<main class="profile">
  <a class="profile__back" href="/profile.html">←</a>
  <div class="profile__content">
    {{{avatar}}}
    <form class="profile__form">
      <div class="profile__fields">
        {{#each fields}}{{{this}}}{{/each}}
      </div>
      <div class="profile__submit">
        {{{button}}}
      </div>
    </form>
  </div>
</main>
